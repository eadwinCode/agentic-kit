{
  "name": "use-agentenkit",
  "version": "0.1.0",
  "description": "React hook for agentenkit \u2014 durable threads, live streaming, human-in-the-loop approvals and nested runs, with every route and label under your control.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eadwinCode/agentic-kit.git",
    "directory": "packages/use-agentenkit"
  },
  "homepage": "https://eadwincode.github.io/agentic-kit/",
  "bugs": {
    "url": "https://github.com/eadwinCode/agentic-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run typecheck && bun run build",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "react",
    "hooks",
    "ai",
    "agents",
    "streaming",
    "human-in-the-loop"
  ]
}
