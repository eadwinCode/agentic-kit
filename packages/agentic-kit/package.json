{
  "name": "@agentic-kit/core",
  "version": "0.1.0",
  "description": "Durable runtime for AI agent runs \u2014 a platform-owned loop, queue-dispatched execution that outlives the request, HITL suspension, nested runs, and context compaction. Bring your own storage, queue, bus and kv via four ports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./adapters/prisma": {
      "types": "./dist/src/adapters/prisma.d.ts",
      "import": "./dist/src/adapters/prisma.js",
      "default": "./dist/src/adapters/prisma.js"
    },
    "./adapters/redis": {
      "types": "./dist/src/adapters/redis.d.ts",
      "import": "./dist/src/adapters/redis.js",
      "default": "./dist/src/adapters/redis.js"
    },
    "./adapters/qstash": {
      "types": "./dist/src/adapters/qstash.d.ts",
      "import": "./dist/src/adapters/qstash.js",
      "default": "./dist/src/adapters/qstash.js"
    },
    "./adapters/upstash": {
      "types": "./dist/src/adapters/upstash.d.ts",
      "import": "./dist/src/adapters/upstash.js",
      "default": "./dist/src/adapters/upstash.js"
    },
    "./adapters/memory": {
      "types": "./dist/src/adapters/memory.d.ts",
      "import": "./dist/src/adapters/memory.js",
      "default": "./dist/src/adapters/memory.js"
    },
    "./adapters/*": {
      "types": "./dist/src/adapters/*.d.ts",
      "import": "./dist/src/adapters/*.js",
      "default": "./dist/src/adapters/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build",
    "prepare": "bun run build"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "ai": "^4.3.16",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0",
    "@upstash/qstash": ">=2.6.0",
    "@upstash/redis": ">=1.31.0",
    "redis": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@upstash/qstash": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "redis": "^6.2.1",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "ai",
    "agents",
    "durable-execution",
    "human-in-the-loop",
    "ai-sdk",
    "ports-and-adapters"
  ]
}
