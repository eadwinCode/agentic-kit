{
  "name": "@agent/core",
  "version": "0.1.0",
  "description": "Headless multi-tenant real-time AI agent platform — engine, HITL suspension, subagents, context compaction. Bring your own storage, queue, and pub/sub via ports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "ai": "^4.3.16",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0",
    "@upstash/qstash": ">=2.6.0",
    "@upstash/redis": ">=1.31.0",
    "redis": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@upstash/qstash": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "redis": "^4.7.0",
    "typescript": "^5.6.3"
  }
}
