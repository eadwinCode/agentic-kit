# The model. Required.
OPENAI_API_KEY=""
# Optional: another OpenAI model (default gpt-4o-mini).
MODEL=""

# Clevix Flow. Make an app in the Flow dashboard and copy its signing key.
# Required.
FLOW_SIGNING_KEY=""
# The engine. Empty is the hosted one; a local engine is http://127.0.0.1:8787.
FLOW_BASE_URL=""
# The app's ID in Flow (default agentenkit-flow-ts).
FLOW_APP_ID=""
