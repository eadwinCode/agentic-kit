# The model. Required.
OPENAI_API_KEY=""
# Where commands run: docker (the default; needs a Docker daemon), e2b (needs
# E2B_API_KEY, https://e2b.dev/dashboard), or local (a folder on this machine
# with no isolation: only for trying things out; every tool then asks first).
SANDBOX="docker"
E2B_API_KEY=""
# Optional: the Docker image (default python:3.12-slim), another OpenAI model
# (default gpt-4o-mini).
SANDBOX_IMAGE=""
MODEL=""
