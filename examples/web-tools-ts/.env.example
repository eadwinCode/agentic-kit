# The model. Required.
OPENAI_API_KEY=""
# Search: Brave when its key is set, else Jina. With neither, the agent can
# read pages but not search. Keys: https://api-dashboard.search.brave.com and
# https://jina.ai/api-dashboard
BRAVE_API_KEY=""
JINA_API_KEY=""
# "jina" reads pages through Jina Reader (pages built with JavaScript, PDFs)
# instead of the free built-in reader.
WEB_READER=""
# Optional: another OpenAI model (default gpt-4o-mini).
MODEL=""
