# PostgreSQL (PrismaStorage)
DATABASE_URL="postgres://postgres:password@localhost:5433/agent"

# Redis — local Docker or self-hosted (RedisKv + RedisBus). No Upstash needed.
REDIS_URL="redis://localhost:6379"

# Upstash QStash (durable queue dispatch + worker signature verification).
# Still required for the worker path; for local dev use the QStash dev CLI:
# https://docs.upstash.com/qstash/how-tos/local-development
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="signing-key"
QSTASH_NEXT_SIGNING_KEY="next-signing-key"

# Public origin the queue calls back into (QStash dev: http://localhost:3000)
APP_URL="http://localhost:3000"

# Model providers (§2.3 registry)
OPENAI_API_KEY="sk-proj-your-key-here"
