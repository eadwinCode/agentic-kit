// Reference schema (spec §2.4) backing PrismaStorage.
// bunx prisma migrate dev --name init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ExecutionState {
  IDLE
  RUNNING
  WAITING_FOR_INPUT
  CANCELLED
  COMPLETED
  FAILED
}

model Thread {
  id        String         @id @default(cuid())
  title     String         @default("New Thread")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  state     ExecutionState @default(IDLE)
  model     String         @default("gpt-4o")

  messages     Message[]
  usage        TokenUsage[]
  events       AgentEvent[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  agentId   String?  // producing agent; null = main agent (§2.7)
  role      String   // 'user' | 'assistant' | 'system' | 'tool'
  content   Json
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  threadId  String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, seq])
  @@index([threadId, type, createdAt])
}

// One row per MODEL CALL (§4), not per run segment: the runtime writes one
// after every call it makes, priced by the configured pricer before it gets
// here. cachedInputTokens holds cache READS; cache writes are their own column
// beside it, because a cache write costs more than a fresh input token. A NULL
// costMicros is an unpriced call, which is not the same as one that cost
// nothing.
model TokenUsage {
  id                    String   @id @default(cuid())
  threadId              String
  runId                 String?  // the DISPATCHED run this call is billed to
  agentId               String?  // subagent attribution; null = main run (§2.7)
  agentName             String?  // the name a bill line should say
  kind                  String   @default("step") // "step" | "compaction"
  step                  Int      @default(0) // 1-based iteration; 0 for compaction
  model                 String?  // registry key the call was made with
  modelId               String?  // wire id it resolved to
  inputTokens           Int      @default(0) // fresh (uncached) prompt tokens
  cachedInputTokens     Int      @default(0) // prompt tokens read from the cache (§2.6)
  cacheWriteInputTokens Int      @default(0) // prompt tokens written into it
  outputTokens          Int      @default(0)
  reasoningTokens       Int      @default(0) // usually already inside outputTokens
  totalTokens           Int      // input + cache reads + output
  outcome               String   @default("finished") // "finished" | "aborted" | "error"
  estimated             Boolean  @default(false) // tokens were estimated, not reported
  providerMetadata      Json?    // what the provider attached to the finish
  costMicros            BigInt?  // millionths of costCurrency; NULL = unpriced
  costCurrency          String?
  costSource            String? // "receipt" | "table" | "estimate"
  createdAt             DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, agentId])
  // One run's whole bill, nested runs included, is one indexed read.
  @@index([runId, createdAt])
}
