// Reference schema (spec §2.4) backing PrismaStorage.
// bunx prisma migrate dev --name init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ExecutionState {
  IDLE
  RUNNING
  WAITING_FOR_INPUT
  CANCELLED
  COMPLETED
  FAILED
}

model Thread {
  id        String         @id @default(cuid())
  title     String         @default("New Thread")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  state     ExecutionState @default(IDLE)
  model     String         @default("gpt-4o")

  messages     Message[]
  usage        TokenUsage[]
  events       AgentEvent[]
  runs         AgentRun[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  agentId   String?  // producing agent; null = main agent (§2.7)
  role      String   // 'user' | 'assistant' | 'system' | 'tool'
  content   Json
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  threadId  String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, seq])
  @@index([threadId, type, createdAt])
}

// One row per run — dispatched or nested (§2.7, §2.9). A subagent IS a run:
// same loop, same steps, same duration, same tokens. It is distinguished by
// depth > 0 and a parentRunId, not by living in a separate table.
model AgentRun {
  id          String         @id
  threadId    String
  parentRunId String? // null = a dispatched run (§2.1)
  depth       Int            @default(0) // 0 = the main agent
  agent       String // handle name, or the delegation's name when nested
  model       String
  state       ExecutionState @default(RUNNING)
  stopReason  String?
  error       String? // why it failed — previously dropped entirely (§2.8)
  startedAt   DateTime       @default(now())
  endedAt     DateTime?
  durationMs  Int?
  queuedMs    Int? // enqueue -> pickup; the worker backlog signal (§2.8)
  attempts    Int            @default(0)
  steps       Int            @default(0)

  inputTokens       Int @default(0)
  cachedInputTokens Int @default(0)
  outputTokens      Int @default(0)
  totalTokens       Int @default(0)

  result Json? // a nested run's capped result (§2.7)

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, startedAt])
  @@index([state, startedAt])
  @@index([parentRunId])
}

model TokenUsage {
  id                String   @id @default(cuid())
  threadId          String
  agentId           String?  // subagent attribution; null = main agent (§2.7)
  inputTokens       Int      @default(0) // fresh (uncached) prompt tokens (§4)
  cachedInputTokens Int      @default(0) // prompt tokens served from provider cache (§2.6)
  outputTokens      Int      @default(0)
  totalTokens       Int      // input + cached + output — pricing is downstream
  createdAt         DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, agentId])
}
