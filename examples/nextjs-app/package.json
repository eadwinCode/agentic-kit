{
  "name": "@agent/example-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:migrate": "bunx prisma migrate dev --name init",
    "dev": "sh -c 'bunx prisma migrate dev --name init || exit $?; qstash-cli dev & QSTASH_PID=$!; trap \"kill $QSTASH_PID\" EXIT INT TERM; next dev -p 5000'",
    "dev:next": "next dev -p 5000",
    "dev:qstash": "qstash-cli dev",
    "build": "next build",
    "start": "next start -p 5000"
  },
  "dependencies": {
    "agentrun": "workspace:*",
    "@ai-sdk/openai": "^1.3.24",
    "@prisma/client": "^5.22.0",
    "@upstash/qstash": "^2.7.0",
    "@upstash/redis": "^1.34.0",
    "@vercel/functions": "^3.9.5",
    "ai": "^4.3.16",
    "next": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.7.0",
    "use-agentrun": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@upstash/qstash-cli": "^2.37.18",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
